{
  "openapi": "3.0.3",
  "info": {
    "title": "E-Library API",
    "version": "1.1.0",
    "description": "REST API for the E-Library application, including authentication, books, files, favorites, reading progress, categories, user profiles, and the admin dashboard."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "API health check"
    },
    {
      "name": "Auth",
      "description": "Registration and authentication"
    },
    {
      "name": "Books",
      "description": "Book discovery and management"
    },
    {
      "name": "Book Files",
      "description": "Book file access"
    },
    {
      "name": "Favorites",
      "description": "User favorite books"
    },
    {
      "name": "Reading",
      "description": "Book reading and reading progress"
    },
    {
      "name": "Reading History",
      "description": "User reading history"
    },
    {
      "name": "Categories",
      "description": "Book categories"
    },
    {
      "name": "Users",
      "description": "Authenticated user profile and password management"
    },
    {
      "name": "Dashboard",
      "description": "Admin dashboard statistics"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the JWT returned by the login endpoint."
      }
    },
    "parameters": {
      "BookId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Book ID.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      },
      "CategoryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Category ID.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      },
      "Search": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Search term used to find books.",
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "javascript"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number. Defaults to the backend pagination default when omitted.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Number of books per page. Defaults to the backend pagination default when omitted.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 10
      }
    },
    "schemas": {
      "AuthRegisterRequest": {
        "type": "object",
        "required": ["full_name", "email", "password"],
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "StrongPassword123"
          }
        },
        "additionalProperties": false
      },
      "AuthLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPassword123"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "full_name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "role": {
            "type": "string",
            "example": "User"
          },
          "profile_image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-10T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-10T12:00:00.000Z"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Login successful."
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "BookCreateRequest": {
        "type": "object",
        "required": [
          "category_id",
          "title",
          "author",
          "description",
          "isbn",
          "publication_year",
          "language",
          "pages",
          "document"
        ],
        "properties": {
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Clean Code"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "example": "Robert C. Martin"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "example": "A handbook of agile software craftsmanship."
          },
          "isbn": {
            "type": "string",
            "example": "9780132350884"
          },
          "publication_year": {
            "type": "integer",
            "example": 2008
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "example": "English"
          },
          "pages": {
            "type": "integer",
            "minimum": 1,
            "example": 464
          },
          "document": {
            "type": "string",
            "format": "binary",
            "description": "Book PDF/document file."
          },
          "cover": {
            "type": "string",
            "format": "binary",
            "nullable": true,
            "description": "Optional book cover image."
          }
        }
      },
      "BookUpdateRequest": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Clean Code"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "example": "Robert C. Martin"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "example": "Updated description."
          },
          "isbn": {
            "type": "string",
            "example": "9780132350884"
          },
          "publication_year": {
            "type": "integer",
            "example": 2008
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "example": "English"
          },
          "pages": {
            "type": "integer",
            "minimum": 1,
            "example": 464
          }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Clean Code"
          },
          "author": {
            "type": "string",
            "example": "Robert C. Martin"
          },
          "description": {
            "type": "string",
            "example": "A handbook of agile software craftsmanship."
          },
          "isbn": {
            "type": "string",
            "example": "9780132350884"
          },
          "publication_year": {
            "type": "integer",
            "example": 2008
          },
          "language": {
            "type": "string",
            "example": "English"
          },
          "pages": {
            "type": "integer",
            "example": 464
          },
          "download_count": {
            "type": "integer",
            "example": 12
          },
          "category_id": {
            "type": "integer",
            "example": 1
          },
          "category_name": {
            "type": "string",
            "example": "Computer Science"
          },
          "created_by": {
            "type": "integer",
            "example": 1
          },
          "creator_name": {
            "type": "string",
            "example": "John Doe"
          },
          "cover_image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://res.cloudinary.com/example/image/upload/book-cover.jpg"
          },
          "file_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://res.cloudinary.com/example/raw/upload/book.pdf"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Programming"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Books about software development."
          }
        },
        "additionalProperties": false
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Computer Science"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Programming, Software Engineering, AI, Databases"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "required": ["full_name", "email"],
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.new@example.com"
          }
        },
        "additionalProperties": false
      },
      "PasswordUpdateRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "example": "OldPassword123"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "NewPassword456"
          }
        },
        "additionalProperties": false
      },
      "ReadingProgressUpdateRequest": {
        "type": "object",
        "required": ["last_page"],
        "properties": {
          "last_page": {
            "type": "integer",
            "minimum": 1,
            "example": 42
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "An error occurred."
          }
        }
      },
      "BookListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "count": {
            "type": "integer",
            "example": 10
          },
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Book"
            }
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "count": {
            "type": "integer",
            "example": 20
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "BookResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Book retrieved successfully."
          },
          "book": {
            "$ref": "#/components/schemas/Book"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "total_users": {
            "type": "integer",
            "example": 25
          },
          "total_books": {
            "type": "integer",
            "example": 80
          },
          "total_categories": {
            "type": "integer",
            "example": 20
          },
          "total_downloads": {
            "type": "integer",
            "example": 140
          },
          "total_favorites": {
            "type": "integer",
            "example": 90
          },
          "total_reading_history": {
            "type": "integer",
            "example": 210
          }
        }
      },
      "DashboardResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "stats": {
            "$ref": "#/components/schemas/DashboardStats"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["password", "confirm_password"],
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "NewPassword456"
          },
          "confirm_password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "NewPassword456"
          }
        },
        "additionalProperties": false
      },
      "PasswordResetResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Password reset successfully."
          }
        }
      },
      "EmailVerificationHtmlResponse": {
        "type": "string",
        "description": "HTML page confirming that the email address has been verified."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required or token is invalid/expired.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated user does not have permission for this resource.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Request validation failed or required data is missing.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Request conflicts with existing data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is running."
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Register a new user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Login user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "operationId": "getBooks",
        "summary": "Get all books or search books",
        "tags": ["Books"],
        "parameters": [
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Books returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookListResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "operationId": "createBook",
        "summary": "Upload a new book",
        "tags": ["Books"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/BookCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book uploaded successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/books/{id}": {
      "get": {
        "operationId": "getBook",
        "summary": "Get a single book by ID",
        "tags": ["Books"],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "200": {
            "description": "Book found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "operationId": "updateBook",
        "summary": "Update a book",
        "tags": ["Books"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "operationId": "deleteBook",
        "summary": "Delete a book",
        "tags": ["Books"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "200": {
            "description": "Book deleted successfully."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/books/{id}/files": {
      "get": {
        "operationId": "getBookFiles",
        "summary": "Get files for a book",
        "tags": ["Book Files"],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "200": {
            "description": "Book files returned."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/books/{id}/download": {
      "get": {
        "operationId": "downloadBook",
        "summary": "Download a book",
        "tags": ["Books"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "200": {
